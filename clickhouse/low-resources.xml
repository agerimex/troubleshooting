<!--
  Defaults for a big production server keep an idle ClickHouse at ~10% of a
  core under Docker Desktop, while our own data is tiny. With these settings
  it idles under 1%. The biggest wins were async_insert_threads and the
  synchronous logger (both poll on short timers); the system logs below are
  written and merged around the clock. query_log and error_log stay on for
  debugging slow or failing queries.
-->
<clickhouse>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <query_metric_log remove="1"/>
    <latency_log remove="1"/>
    <part_log remove="1"/>
    <processors_profile_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <session_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <background_schedule_pool_log remove="1"/>
    <!-- Server metrics are recomputed every second by default; nothing here reads them. -->
    <asynchronous_metrics_update_period_s>60</asynchronous_metrics_update_period_s>
    <!-- The image logs at trace level by default. -->
    <logger>
        <level>information</level>
        <!-- The async logger polls in a loop even when there is nothing to write. -->
        <async>false</async>
    </logger>
    <!-- 16 threads poll the async insert queue on a short timer; we never use
         async inserts. -->
    <async_insert_threads>1</async_insert_threads>
    <!-- At startup ClickHouse hashes its own ~500 MB binary. In a new container
         under Docker Desktop that read is so slow that the first start took
         4-10 minutes (restarts of the same container: under a second). -->
    <skip_binary_checksum_checks>true</skip_binary_checksum_checks>

    <!-- Memory. By default the server may take 90% of the machine's RAM and
         each cache (marks, primary index, uncompressed blocks, index marks)
         up to half of it, about 2 GB each in Docker Desktop's 4 GB VM. Two
         ClickHouse servers there (a dev and a test stack) plus other
         containers exhausted the VM and Docker killed every container.
         Measured with the regression fixture (load and check): the server
         peaks near 500 MB, its largest query near 60 MB, so these caps leave
         room. The API's own per-query limit (QUERY_MAX_MEMORY_BYTES, 1 GiB)
         stays below the server cap. Background pools are left at their
         defaults: smaller ones crash-loop the server (merge_tree's
         number_of_free_entries_in_pool_* must fit in them). -->
    <max_server_memory_usage_to_ram_ratio>0.4</max_server_memory_usage_to_ram_ratio>
    <cache_size_to_ram_max_ratio>0.1</cache_size_to_ram_max_ratio>
    <mark_cache_size>268435456</mark_cache_size>
    <primary_index_cache_size>134217728</primary_index_cache_size>
    <uncompressed_cache_size>134217728</uncompressed_cache_size>
    <index_mark_cache_size>67108864</index_mark_cache_size>
</clickhouse>
